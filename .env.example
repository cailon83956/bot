# ============================================================
# Sao chép thành .env rồi điền.
# Trên Kaggle có thể dùng Add-ons > Secrets (DISCORD_TOKEN / TELEGRAM_BOT_TOKEN).
# ============================================================

# --- Bot Telegram ---
# Token lấy ở @BotFather
TELEGRAM_BOT_TOKEN=
# ID user Telegram được phép quản lý model (tuỳ chọn, nhiều ID cách nhau bằng dấu phẩy)
ADMIN_IDS=

# --- Bot Discord ---
DISCORD_TOKEN=
# ID server để lệnh / hiện NGAY (bỏ trống = sync global, có thể mất tới 1 giờ)
GUILD_ID=
# Role được phép quản lý model (tuỳ chọn)
ADMIN_ROLE_IDS=

# --- Chung cho cả hai bot ---
# ID của bạn (Telegram user ID hoặc Discord user ID) - toàn quyền quản trị.
# Nhiều ID cách nhau bằng dấu phẩy. Xem README để lấy Telegram user ID.
OWNER_IDS=
# Cho phép mọi người thêm model (1) hay chỉ admin (0)
ALLOW_USER_MODELS=0
MAX_DURATION_MIN=10
MAX_JOBS_PER_USER=3
MAX_QUEUE=20
CLEAN_AFTER_HOURS=12
# File quá lớn không nén vừa -> up lên litterbox.catbox.moe (xoá sau 72h)
UPLOAD_FALLBACK=0
# cookies.txt của YouTube (khi bị chặn "Sign in to confirm you're not a bot")
YT_COOKIES_FILE=
